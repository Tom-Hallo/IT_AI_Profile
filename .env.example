# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=ai_talent_profile
POSTGRES_USER=ita
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
# Khóa mã hóa 32-bytes urlsafe base64 cho token GitHub (Fernet key)
GITHUB_TOKEN_ENCRYPTION_KEY=aXRfdGFsZW50X2FpX3Byb2ZpbGVfZmVybmV0X2tleV8=

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api/v1
FRONTEND_WATCH_POLLING=true

# Worker
WORKER_QUEUES=default