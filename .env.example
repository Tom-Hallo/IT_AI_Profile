# IT Talent AI Profile - cấu hình môi trường PHÁT TRIỂN (Technical Blueprint, mục 5).
# Đây là NGUỒN CHUẨN khi chạy bằng Docker Compose.
#
# Cách dùng:  cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#             hoặc chạy ./scripts/setup.sh | .\scripts\setup.ps1 (tự sao chép, không ghi đè .env có sẵn)
#
# - File .env KHÔNG được commit (đã nằm trong .gitignore).
# - Mọi giá trị dưới đây chỉ là MẪU cho máy dev. KHÔNG dùng cho staging/production.
# - DATABASE_URL và REDIS_URL KHÔNG đặt ở đây: Compose tự ghép từ các biến POSTGRES_*.

# --- Chung (backend, worker) ---
# development | test | production. Ngoài "development" thì tắt Swagger/OpenAPI.
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=ita
# Mật khẩu MẪU, chỉ cho dev. Hãy đổi trước khi dùng thật.
# Chỉ dùng chữ và số (hoặc - _): ký tự @ : / ? # % làm hỏng DATABASE_URL.
# Lưu ý: giá trị POSTGRES_* chỉ có tác dụng khi volume được tạo LẦN ĐẦU.
# Đổi sau đó phải chạy `docker compose down -v` (XÓA dữ liệu DB) rồi up lại.
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=it_ai_profile

# --- Port trên MÁY HOST (đổi nếu máy bạn đã có dịch vụ dùng port này) ---
# Tất cả đều chỉ gắn vào 127.0.0.1. Port bên trong container không đổi.
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- Backend ---
# Danh sách phân tách bằng dấu phẩy. KHÔNG dùng *.
CORS_ORIGINS=http://localhost:5173

# --- Worker ---
# Danh sách hàng đợi phân tách bằng dấu phẩy.
WORKER_QUEUES=default

# --- Frontend ---
# Địa chỉ API mà TRÌNH DUYỆT gọi (đường dẫn tương đối, đi qua proxy của Vite, cùng origin).
# Chỉ biến bắt đầu bằng VITE_ mới lộ ra trình duyệt: KHÔNG đặt secret vào biến VITE_*.
VITE_API_BASE_URL=/api/v1
# Địa chỉ Backend mà proxy của Vite gọi, BÊN TRONG mạng Docker: dùng tên service "backend",
# không dùng localhost (trong container, localhost là chính container frontend).
BACKEND_INTERNAL_URL=http://backend:8000
# Đặt true nếu hot-reload không chạy (thường gặp khi bind mount từ ổ Windows).
FRONTEND_WATCH_POLLING=false
