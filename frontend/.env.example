# CHỈ dùng khi chạy frontend NGOÀI Docker (npm run dev trên máy bạn).
# Khi chạy bằng Docker Compose, nguồn chuẩn là file .env.example ở thư mục GỐC repo.
# Cách dùng: sao chép file này thành frontend/.env (file .env không được commit).

# Địa chỉ API mà trình duyệt gọi. Giữ nguyên /api/v1 (đi qua proxy của Vite, cùng origin).
# Chỉ biến bắt đầu bằng VITE_ mới lộ ra trình duyệt: KHÔNG đặt secret ở đây.
VITE_API_BASE_URL=/api/v1

# Địa chỉ Backend mà proxy của Vite chuyển tiếp tới (chỉ dùng phía Node, không lộ ra bundle).
# Chạy ngoài Docker: dùng 127.0.0.1 (không dùng localhost để tránh lỗi phân giải IPv6).
# Trong Docker Compose giá trị này là http://backend:8000 (do file .env gốc cấp).
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Đặt true nếu hot-reload không hoạt động (thường gặp khi bind mount từ ổ Windows).
FRONTEND_WATCH_POLLING=false
