# Copy to .env.production; do not commit the resulting file.
# Use URL-safe hex for database password (openssl rand -hex 32).
POSTGRES_USER=ita
POSTGRES_DB=it_ai_profile
POSTGRES_PASSWORD=
GITHUB_TOKEN_ENCRYPTION_KEY=
# Generate a separate GitHub OAuth App for production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=https://profile.example.com
CORS_ORIGINS=https://profile.example.com
GITHUB_REDIRECT_URI=https://profile.example.com/api/v1/auth/github/callback
PROD_HTTP_PORT=8080
BACKEND_WORKERS=1
LOG_LEVEL=INFO
WORKER_QUEUES=default
# Tag images with the release commit SHA for rollback.
ITA_IMAGE_TAG=local-prod
# Configure a private reachable Ollama endpoint or the existing cloud provider.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
AI_BASE_URL=http://host.docker.internal:11434
AI_API_KEY=
AI_TIMEOUT_SECONDS=120
AI_MAX_INPUT_CHARS=50000
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_REQUESTS_PER_DAY=50
