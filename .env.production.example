# Copy to .env.production on the server only; never commit the populated file.
DOMAIN=profile.example.com
LOG_LEVEL=INFO
POSTGRES_USER=ita
POSTGRES_DB=it_ai_profile
POSTGRES_PASSWORD=
# Set full DSN with URL-encoded password (same DB credentials above).
DATABASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=
WORKER_QUEUES=default
# Use an available provider/model. For Ollama, set a private reachable service URL.
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=120
AI_MAX_INPUT_CHARS=50000
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_REQUESTS_PER_DAY=50
