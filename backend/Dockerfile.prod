FROM python:3.12-slim AS build
WORKDIR /build
COPY pyproject.toml ./
RUN python -m venv /opt/venv && mkdir app && touch app/__init__.py \
    && /opt/venv/bin/pip install --no-cache-dir . \
    && /opt/venv/bin/pip uninstall -y it-ai-profile-backend

FROM python:3.12-slim AS runtime
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/app PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
RUN useradd --create-home --uid 1000 appuser \
    && install -d -o appuser -g appuser -m 0700 /tmp/ita-private-code
COPY --from=build /opt/venv /opt/venv
COPY --chown=appuser:appuser app ./app
COPY --chown=appuser:appuser migrations ./migrations
COPY --chown=appuser:appuser alembic.ini ./alembic.ini
USER appuser
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
