# CHỈ dùng khi chạy backend NGOÀI Docker (uvicorn trên máy bạn).
# Khi chạy bằng Docker Compose, nguồn chuẩn là file .env.example ở thư mục GỐC repo
# (Compose tự ghép DATABASE_URL và REDIS_URL, không đặt trong file .env gốc).
# Cách dùng: sao chép thành backend/.env (file .env không được commit).
# Đây chỉ là giá trị mẫu, KHÔNG phải secret thật.

APP_ENV=development
LOG_LEVEL=INFO

# Chạy ngoài Docker: dùng 127.0.0.1 (không dùng localhost để tránh lỗi IPv6).
# Bắt buộc driver psycopg v3: postgresql+psycopg://
# Mật khẩu tránh ký tự đặc biệt (@ : / ?) vì nằm trong URL.
DATABASE_URL=postgresql+psycopg://ita:change-me-dev-only@127.0.0.1:5432/it_ai_profile
REDIS_URL=redis://127.0.0.1:6379/0

# Danh sách phân tách bằng dấu phẩy. KHÔNG dùng *.
CORS_ORIGINS=http://localhost:5173
WORKER_QUEUES=default
